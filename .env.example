# Get a token from @BotFather. NEVER commit your real .env file.
# 从 @BotFather 获取 Token，切勿提交真实的 .env 文件。
TELEGRAM_BOT_TOKEN=123456:replace-me

# binance or gate (public ticker endpoints, no API key needed)
PRICE_SOURCE=binance

# Seconds between price checks
CHECK_INTERVAL=30

# SQLite file path
DB_PATH=data/alerts.db

# Optional: comma separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# Optional HTTP proxy for price API and Telegram, e.g. http://127.0.0.1:7890
HTTP_PROXY_URL=
